<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <com.petitpoint.vision.ui.ScannerOverlayView
        android:id="@+id/scannerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.petitpoint.vision.ui.PatternOverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:orientation="vertical">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Goblenul meu"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/pageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="Pagina 1/16"
            android:textColor="#B8F7FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/scanText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="GRILĂ: caut ochiurile…"
            android:textColor="#77FFBB"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/magnifierHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="🔎 LUPĂ: mărește cu două degete, apoi ALINIAZĂ pe ochiul țintă"
            android:textColor="#FFD36A"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#F0111111"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <Button
                android:id="@+id/prevPageButton"
                android:layout_width="48dp"
                android:layout_height="42dp"
                android:text="◀" />

            <Button
                android:id="@+id/importPageButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Pagina curentă" />

            <Button
                android:id="@+id/importAllPagesButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Încarcă 16" />

            <Button
                android:id="@+id/nextPageButton"
                android:layout_width="48dp"
                android:layout_height="42dp"
                android:text="▶" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <EditText
                android:id="@+id/codeInput"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:hint="Cartela 1–59"
                android:imeOptions="actionSearch"
                android:inputType="number"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#BBBBBB" />

            <Button
                android:id="@+id/searchCodeButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="Caută" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/symbolPreview"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="#FFFFFF"
                android:contentDescription="Simbol cartelă"
                android:padding="4dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/symbolText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:paddingStart="10dp"
                android:text="Caută o cartelă. Pe pânză apare doar simbolul plutitor."
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <Button
                android:id="@+id/learnSymbolButton"
                android:layout_width="0dp"
                android:layout_height="43dp"
                android:layout_weight="1"
                android:text="Învață simbol" />

            <Button
                android:id="@+id/calibrateButton"
                android:layout_width="0dp"
                android:layout_height="43dp"
                android:layout_weight="1"
                android:text="Aliniază" />

            <Button
                android:id="@+id/clearCalibrationButton"
                android:layout_width="0dp"
                android:layout_height="43dp"
                android:layout_weight="1"
                android:text="Reset alin." />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <Button
                android:id="@+id/prevTargetButton"
                android:layout_width="50dp"
                android:layout_height="42dp"
                android:text="◀" />

            <TextView
                android:id="@+id/guideText"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="Alege cartela"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/nextTargetButton"
                android:layout_width="50dp"
                android:layout_height="42dp"
                android:text="▶" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
